<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.usuario.CadastroUsuarioActivity">

    <!-- Fundo -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/iconeapp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Overlay -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
            android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textCadastroUsuarioTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cadastro de Usuário"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/registerNameEditText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nome"
                android:padding="12dp"
                android:backgroundTint="#1A73E8"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/registerEmailEditText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:backgroundTint="#1A73E8"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/registerPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Senha"
                android:inputType="textPassword"
                android:padding="12dp"
                android:backgroundTint="#1A73E8"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/registerConfirmPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Confirmar Senha"
                android:inputType="textPassword"
                android:padding="12dp"
                android:backgroundTint="#1A73E8"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/salvarButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Cadastrar"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#1A73E8"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/sairButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Sair"
                android:textColor="#000"
                android:backgroundTint="#E0E0E0"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>